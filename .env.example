# Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set to a test server's guild ID for instant command registration during development.
# Leave empty to register commands globally (takes up to ~1 hour to propagate).
DEPLOY_GUILD_ID=

# Must match lavalink/application.yml's server.password
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=changeme_use_a_strong_password

# Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
# Used only to resolve track/playlist metadata; playback is streamed from YouTube.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius API client access token (https://genius.com/api-clients)
GENIUS_API_KEY=

# YouTube now requires an authenticated session for many videos ("This video
# requires login" errors). On first run, leave this line commented out/absent
# entirely (not just blank!) and check `docker compose logs -f lavalink` for a
# device-code link. Complete it with a Google account (use a secondary/
# throwaway account, not your main one). Lavalink will then print a refresh
# token in the logs — paste it here, uncomment the matching line in
# docker-compose.yml's lavalink service, and restart.
# YOUTUBE_OAUTH_REFRESHTOKEN=
